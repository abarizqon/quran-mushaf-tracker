# ==========================================
# .gitignore - Quran & Tilawah Tracker
# ==========================================

# 1. Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# 2. Editor & IDE Settings
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# 3. Node Dependencies & Logs (jika developer memakai bundler/npm)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 4. Cache, Temp & Build Outputs
.cache/
.temp/
dist/
build/
*.tmp
*.bak
